{
    "version": 6,
    "cmakeMinimumRequired": { "major": 3, "minor": 25, "patch": 0 },
    "configurePresets": [
        {
            "name": "android-arm64-release",
            "displayName": "Android ARM64 Release (Vulkan)",
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/../out/android-arm64-release",
            "cacheVariables": {
                "CMAKE_TOOLCHAIN_FILE": "$env{ANDROID_NDK_HOME}/build/cmake/android.toolchain.cmake",
                "ANDROID_ABI": "arm64-v8a",
                "ANDROID_PLATFORM": "android-29",
                "ANDROID_STL": "c++_shared",
                "CMAKE_BUILD_TYPE": "Release",
                "REXGLUE_USE_VULKAN": "ON",
                "REXGLUE_USE_D3D12": "OFF",
                "REXGLUE_ENABLE_TRACY": "OFF",
                "REXSDK_DIR": "$env{REXSDK_DIR}"
            }
        }
    ],
    "buildPresets": [
        { "name": "android-arm64-release", "configurePreset": "android-arm64-release" }
    ]
}
